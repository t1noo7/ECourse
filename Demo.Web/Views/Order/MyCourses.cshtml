@using Demo.Core.Models
@model (List<Course> MyCourses, List<Course> SuggestedCourses)

<div class="container-xxl py-5">
    <div class="container">
        <!-- Khóa học của tôi -->
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Khóa Học Của Tôi</h6>
        </div>
        <div class="row g-4 justify-content-center">
            @if (Model.MyCourses != null && Model.MyCourses.Any())
            {
                foreach (var item in Model.MyCourses)
                {
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="course-item bg-light">
                            <div class="position-relative overflow-hidden">
                                <a href="@Url.Action("MyLessons", "Order", new { courseId = item.Id })">
                                    <img class="img-fluid" src="@item.Image" alt="@item.Title">
                                    </a>
                                <div class="progress" style="height: 5px;">
                                    @* <div class="progress-bar bg-success" role="progressbar" style="width: @item.Progress%" aria-valuenow="@item.Progress" aria-valuemin="0" aria-valuemax="100"></div> *@
                                </div>
                            </div>
                            <div class="text-center p-4 pb-0">
                                <h5 class="mb-4">@item.Title</h5>
                                @* <p>Tiến trình học: <strong>@item.Progress%</strong></p> *@
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Bạn chưa tham gia khóa học nào.</p>
            }
        </div>

        <!-- Khóa học gợi ý -->
        <div class="text-center wow fadeInUp mt-5" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Khóa Học Gợi Ý</h6>
        </div>
        <div class="row g-4 justify-content-center">
            @if (Model.SuggestedCourses != null && Model.SuggestedCourses.Any())
            {
                foreach (var item in Model.SuggestedCourses)
                {
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="course-item bg-light">
                            <div class="position-relative overflow-hidden">
                                <img class="img-fluid" src="@item.Image" alt="@item.Title">
                                <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                                    <a href="#" class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end" style="border-radius: 30px 0 0 30px;">Xem Thêm</a>
                                    <a href="javascript:void(0)" class="flex-shrink-0 btn btn-sm btn-primary px-3"
                                       style="border-radius: 0 30px 30px 0;"
                                       onclick="joinCourse('@item.Id')">Tham Gia Ngay</a>

                                </div>
                            </div>
                            <div class="text-center p-4 pb-0">
                                @if (item.DiscountPrice != null)
                                {
                                    <h3 class="mb-0">@item.DiscountPrice?.ToString("#,##0 VNĐ")</h3>
                                } else
                                {
                                    <h3 class="mb-0">@item.Price.ToString("#,##0 VNĐ")</h3>
                                }
                                <div class="mb-3">
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small>(123)</small>
                                </div>
                                <h5 class="mb-4">@item.Title</h5>
                            </div>
                            <div class="d-flex border-top">
                                <small class="flex-fill text-center border-end py-2"><i class="fa fa-user-tie text-primary me-2"></i>Nguyễn Văn A</small>
                                <small class="flex-fill text-center border-end py-2"><i class="fa fa-clock text-primary me-2"></i>2 Giờ</small>
                                <small class="flex-fill text-center py-2"><i class="fa fa-user text-primary me-2"></i>30 Học Viên</small>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Không có khóa học gợi ý.</p>
            }
        </div>
    </div>
</div>

<script>
    function joinCourse(courseId) {
        window.location.href = '/Order/Checkout?courseId=' + courseId;
    }
</script>
