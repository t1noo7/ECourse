@using Demo.Core.Enums
@using Demo.Core.Models;
@using Demo.Web.Models;
@using Demo.Web.Extensions;
@using Demo.Web.Helpers;
@model OrderViewModel
@{
    var course = ViewBag.Course as Demo.Core.Models.Course;
}

<section class="order_section mt-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="secTitle">Hoàn tất đơn hàng</h2>
        </div>

        <form asp-action="Checkout" method="post">
            <input type="hidden" asp-for="CourseId" />
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h3>Thông tin khách hàng</h3>
                    <div class="form-group">
                        <label class="fw-bold">Tên khách hàng</label>
                        <input type="text" name="customerName" value="@Model.CustomerName" class="form-control"
                            placeholder="Nhập tên của bạn" required>
                    </div>

                    <div class="form-group">
                        <label class="fw-bold">Số điện thoại</label>
                        <input type="tel" name="customerPhone" value="@Model.CustomerPhone" class="form-control"
                            placeholder="Nhập số điện thoại của bạn" required>
                    </div>

                    <div class="form-group">
                        <label class="fw-bold">Email</label>
                        <input type="email" name="customerEmail" value="@Model.CustomerEmail" class="form-control"
                            placeholder="Nhập email của bạn" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <h3>Sản phẩm đã đặt mua</h3>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead class="table-dark">
                                <tr>
                                    <th>Tên khóa học</th>
                                    <th>Ảnh</th>
                                    <th>Nội dung</th>
                                    <th>Giá tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@course.Title</td>
                                    <td><img src="@course.Image" alt="@course.Title" class="img-fluid"
                                            style="max-width: 100px;"></td>
                                    <td>@Html.Raw(@course.Description)</td>
                                    <td id="coursePrice" data-price="@course.Price"
                                        data-discount="@course.DiscountPrice">
                                        @(course.DiscountPrice > 0 ? course.DiscountPrice?.ToString("#,##0 VNĐ") :
                                            course.Price.ToString("#,##0 VNĐ"))
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <input type="hidden" name="CourseIds" value="@course.Id" />
                </div>
            </div>

            <div class="form-group">
                <label class="fw-bold">Hình thức thanh toán</label>
                @Html.DropDownListFor(x => x.PaymentOption, Model.PaymentOptions, new
                    {
                        @class = "form-control"
                    })
                <p>Số tiền được giảm trừ: <span id="paymentOptionDiscountPrice" class="text-success">0</span> VNĐ</p>
            </div>
            <div class="form-group">
                <label class="fw-bold">Mã giảm giá</label>
                @Html.TextBoxFor(x => x.VoucherCode, new { @class = "form-control" })
                <span id="spVoucher" class="green"></span><br />
                <span id="paymentVoucherPrice" class="green" data-price="-1"></span>
                <button class="form-control" id="btVoucher">Áp dụng</button>
            </div>
            <div class="form-group">
                <label class="fw-bold">Thông tin thanh toán</label>
                <p>@Html.Raw(ViewData["BankInfo"])</p>
            </div>
            <div class="form-group">
                <label class="fw-bold">Xác thực thanh toán (* Lưu ý: Vui lòng chụp lại ảnh chuyển khoản thành công để
                    tải lên.)</label>
                @Html.HiddenFor(m => m.VerifyImageUrl)
                <partial name="~/Areas/Admin/Views/Shared/_EditImage.cshtml" model="@Model.VerifyImageUrl" />
            </div>
            <div class="form-group">
                <label class="fw-bold">Ghi chú</label>
                @Html.TextAreaFor(x => x.CustomerNote, new { @class = "form-control" })
            </div>

            <div class="text-center my-4">
                <h4>Tổng tiền phải thanh toán (áp dụng mã giảm giá nếu có): <span id="paymentTotalPrice"
                        class="text-success">0</span> VNĐ</h4>
            </div>

            <div class="text-center">
                <button class="btn btn-primary px-4" type="submit">Hoàn thành</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).on("click", "#confirmCheckout", function () {
                CreateOrder();
            });

            function CreateOrder() {
                var paymentOption = $("#PaymentOption").val();
                if (paymentOption != '1' && paymentOption != '2') {
                    alert("Chưa chọn loại thanh toán!");
                    return;
                }

                $('#loadingModal').modal();
                setTimeout(function () {
                    var model = $("#frmOrder").serializeObject();
                    var courses = [];
                    $(".course:checked").each(function () {
                        courses.push({ 'Id': $(this).attr("data-courseid") });
                    });
                    var result = ajaxHelper.excutePostAjax_ReturnDataJson("/Order/Checkout", { model: model, productIds: courses });
                    if (result && result.success) {
                        $('#loadingModal').modal('hide');
                        alert("Đặt hàng thành công!");
                        setTimeout(function () {
                            window.location = "/Order/MyOrder";
                        }, 1000);
                    } else {
                        $('#loadingModal').modal('hide');
                        alert(result.message);
                    }
                }, 300);
            }

            function voucher(code) {
                var result = ajaxHelper.excutePostAjax_ReturnDataJson("/Order/Voucher", { code: code });
                if (result && result.success) {
                    var price = $("#paymentOptionDiscountPrice").attr("data-price") * 1;
                    var discount = 0;

                    if (result.message.includes('%')) {
                        var percent = result.message.replace('%', '') * 1;
                        discount = price * percent / 100;
                    } else if (result.message.includes('vnd')) {
                        discount = result.message.replace('vnd', '') * 1;
                    }

                    $("#spVoucher").html("Giảm giá: " + result.message);
                    $("#paymentVoucherPrice").attr("data-price", discount);
                    $("#paymentVoucherPrice").html("Số tiền sau khi áp dụng voucher: " + discount.toLocaleString() + " vnd");
                    totalPrice();
                } else {
                    toastr.error(result.message);
                }
            }

            function totalPrice() {
                var coursePrice = $("#coursePrice").data("price") * 1 || 0;
                var discountPrice = $("#coursePrice").data("discount") * 1 || 0;
                var finalPrice = discountPrice > 0 ? discountPrice : coursePrice;

                var paymentDiscount = $("#paymentOptionDiscountPrice").attr("data-price") * 1 || 0;
                var voucherDiscount = $("#paymentVoucherPrice").attr("data-price") * 1 || 0;

                var total = (finalPrice - paymentDiscount - voucherDiscount);
                total = total > 0 ? total : 0;

                $("#paymentTotalPrice").text(total.toLocaleString() + " VNĐ");
            }

            $("#PaymentOptions").change(function () {
                var discount = $(this).find(":selected").data("discount") * 1 || 0;
                $("#paymentOptionDiscountPrice").text(discount.toLocaleString());
                totalPrice();
            });

            $("#btVoucher").click(function (e) {
                e.preventDefault();
                var code = $("#VoucherCode").val();
                if (!code) {
                    alert("Vui lòng nhập mã giảm giá.");
                    return;
                }
                $.post("/Order/Voucher", { code: code }, function (result) {
                    if (result.success) {
                        var discount = result.discount * 1;
                        $("#spVoucher").text("Giảm giá: " + discount.toLocaleString() + " VNĐ");
                        $("#paymentOptionDiscountPrice").text(discount.toLocaleString());
                        totalPrice();
                    } else {
                        alert(result.message);
                    }
                });
            });

            totalPrice();

            $('#PaymentOption').on('change', function () {
                var val = $(this).val();
                var coursePrice = parseFloat($("#coursePrice").data("price")) || 0;
                var discount = 0;

                if (val == '1') {
                    discount = coursePrice * 0.10;
                } else if (val == '2') {
                    discount = coursePrice * 0.15;
                }

                var discountedPrice = coursePrice - discount;

                $("#paymentOptionPrice").html(discountedPrice.toLocaleString() + " VNĐ");
                $("#paymentOptionDiscountPrice").attr("data-price", discount);
                $("#paymentOptionDiscountPrice").html(discount.toLocaleString() + " VNĐ");

                totalPrice();
            });

            $('#fileInput').on('change', function () {
                if (this.files && this.files[0]) {
                    if (this.files[0].type.match(/^image\//)) {
                        Upload(this.files[0]);
                    }
                }
            });

            function Upload(file) {
                var fd = new FormData();
                fd.append('file', file);

                $.ajax({
                    url: '/order/upload',
                    data: fd,
                    processData: false,
                    contentType: false,
                    type: 'POST',
                    beforeSend: function () {
                        $('#loadingModal').modal();
                    },
                    success: function (data) {
                        if (data.success) {
                            $("#VerifyImageUrl").val(data.message);
                        } else {
                            toastr.error("Có lỗi xảy ra khi tải ảnh lên.");
                        }
                    },
                    complete: function () {
                        $('#loadingModal').modal('hide');
                    }
                });
            }
        });
    </script>
}
