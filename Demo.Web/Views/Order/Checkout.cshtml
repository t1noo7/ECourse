@using Demo.Core.Enums
@using Demo.Core.Models;
@using Demo.Web.Models;
@using Demo.Web.Extensions;
@using Demo.Web.Helpers;
@using Demo.Web.ViewModels;
@model OrderViewModel
@{
    var course = ViewBag.Course as Demo.Core.Models.Course;
}

<section class="order_section mt-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="secTitle">Hoàn tất đơn hàng</h2>
        </div>

        <form asp-action="Checkout" method="post">
            <input type="hidden" asp-for="CourseId" />
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h3>Thông tin khách hàng</h3>
                    <div class="form-group">
                        <label class="fw-bold">Tên khách hàng</label>
                        <input type="text" name="customerName" value="@Model.CustomerName" class="form-control"
                            placeholder="Nhập tên của bạn" required>
                    </div>

                    <div class="form-group">
                        <label class="fw-bold">Số điện thoại</label>
                        <input type="tel" name="customerPhone" value="@Model.CustomerPhone" class="form-control"
                            placeholder="Nhập số điện thoại của bạn" required>
                    </div>

                    <div class="form-group">
                        <label class="fw-bold">Email</label>
                        <input type="email" name="customerEmail" value="@Model.CustomerEmail" class="form-control"
                            placeholder="Nhập email của bạn" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <h3>Sản phẩm đã đặt mua</h3>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead class="table-dark">
                                <tr>
                                    <th>Tên khóa học</th>
                                    <th>Ảnh</th>
                                    <th>Nội dung</th>
                                    <th>Giá tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@course.Title</td>
                                    <td><img src="@course.Image" alt="@course.Title" class="img-fluid"
                                            style="max-width: 100px;"></td>
                                    <td>@Html.Raw(@course.Description)</td>
                                    <td id="coursePrice" data-price="@course.Price"
                                        data-discount="@course.DiscountPrice">
                                        @(course.DiscountPrice > 0 ? course.DiscountPrice?.ToString("#,##0 VNĐ") :
                                            course.Price.ToString("#,##0 VNĐ"))
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <input type="hidden" name="CourseIds" value="@course.Id" />
                </div>
            </div>

            <div class="form-group">
                <label class="fw-bold">Mã giảm giá</label>
                @Html.TextBoxFor(x => x.VoucherCode, new { @class = "form-control", @id = "VoucherCode" })
                <span id="spVoucher" class="green"></span><br />
                <span id="paymentVoucherPrice" class="green" data-price="0"></span>
                <button class="form-control mt-2" id="btVoucher">Áp dụng</button>

            </div>
            <div class="form-group">
                <label class="fw-bold">Thông tin thanh toán</label>
                <p>@Html.Raw(ViewData["BankInfo"])</p>
            </div>
            <div class="form-group">
                <label class="fw-bold">Xác thực thanh toán (* Lưu ý: Vui lòng chụp lại ảnh chuyển khoản thành công để
                    tải lên.)</label>
                @Html.HiddenFor(m => m.VerifyImageUrl)
                <partial name="~/Areas/Admin/Views/Shared/_EditImage.cshtml" model="@Model.VerifyImageUrl" />
            </div>
            <div class="form-group">
                <label class="fw-bold">Ghi chú</label>
                @Html.TextAreaFor(x => x.CustomerNote, new { @class = "form-control" })
            </div>

            <div class="text-center my-4">
                <h4>Tổng tiền phải thanh toán (áp dụng mã giảm giá nếu có): <span id="paymentTotalPrice"
                        class="text-success">0</span> VNĐ</h4>
            </div>

            <div class="text-center">
                <button class="btn btn-primary px-4" type="submit">Hoàn thành</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý nút "Xác nhận đặt hàng"
            $("#confirmCheckout").on("click", function () {
                createOrder();
            });

            // Gửi đơn hàng
            async function createOrder() {
                $('#loadingModal').modal('show');

                try {
                    await delay(300); // Đợi 300ms giả lập loading

                    const model = $("#frmOrder").serializeObject();
                    const courses = [];

                    $(".course:checked").each(function () {
                        courses.push({ 'Id': $(this).attr("data-courseid") });
                    });

                    const result = await $.post("/Order/Checkout", {
                        model: model,
                        productIds: courses
                    });

                    $('#loadingModal').modal('hide');

                    if (result?.success) {
                        alert("Đặt hàng thành công!");
                        setTimeout(() => {
                            window.location.href = "/Order/MyOrder";
                        }, 1000);
                    } else {
                        alert(result?.message || "Có lỗi xảy ra khi xử lý đơn hàng.");
                    }
                } catch (error) {
                    $('#loadingModal').modal('hide');
                    alert("Không thể kết nối đến máy chủ. Vui lòng thử lại sau.");
                    console.error("Checkout Error:", error);
                }
            }

            const coursePrice = $("#coursePrice").data("discount") || $("#coursePrice").data("price");
            updateTotal(coursePrice, 0);

            $("#btVoucher").on("click", async function (e) {
                e.preventDefault();
                const code = $("#VoucherCode").val()?.trim();

                if (!code) {
                    alert("Vui lòng nhập mã giảm giá.");
                    return;
                }

                const $btn = $(this);
                $btn.prop("disabled", true).text("Đang kiểm tra...");

                try {
                    const result = await $.post("/Order/ValidateVoucher", {
                        code,
                        originalPrice: coursePrice
                    });

                    if (result?.success) {
                        const finalPrice = result.finalPrice || coursePrice;
                        const discount = coursePrice - finalPrice;

                        $("#VoucherCode").val(code);
                        $("#spVoucher").text("Giảm giá: " + discount.toLocaleString("vi-VN") + " VNĐ");

                        $("#paymentVoucherPrice")
                            .data("price", discount)
                            .html("Số tiền sau khi áp dụng voucher: " + finalPrice.toLocaleString("vi-VN") + " VNĐ")
                            .addClass("highlight");

                        updateTotal(finalPrice, discount);
                        highlightTotal();
                        highlightDiscount();
                    } else {
                        alert(result.message || "Mã giảm giá không hợp lệ.");
                        resetVoucherInfo();
                    }
                } catch (err) {
                    alert("Không thể kiểm tra mã giảm giá. Vui lòng thử lại.");
                    console.error("Voucher Error:", err);
                    resetVoucherInfo();
                } finally {
                    $btn.prop("disabled", false).text("Áp dụng");
                }
            });

            function updateTotal(total, discount) {
                $("#voucherDiscountAmount").text(discount.toLocaleString("vi-VN") + " VNĐ");
                $("#paymentTotalPrice").text(total.toLocaleString("vi-VN") + " VNĐ");
            }

            function resetVoucherInfo() {
                $("#VoucherCode").val("");
                $("#spVoucher").text("");
                $("#paymentVoucherPrice").data("price", 0).text("").removeClass("highlight");
                $("#voucherDiscountAmount").text("0 VNĐ");
                updateTotal(coursePrice, 0);
            }

            function highlightTotal() {
                const $total = $("#paymentTotalPrice");
                $total.addClass("highlight-blink");
                setTimeout(() => {
                    $total.removeClass("highlight-blink");
                }, 1500);
            }

            function highlightDiscount() {
                const $discount = $("#voucherDiscountAmount");
                $discount.addClass("highlight-blink");
                setTimeout(() => {
                    $discount.removeClass("highlight-blink");
                }, 1500);
            }

            // Custom style for highlight effect
            $("<style>")
                .prop("type", "text/css")
                .html(`
                                    .highlight { font-weight: bold; color: green; }
                                    .highlight-blink {
                                        animation: blinkEffect 1.5s ease-in-out;
                                    }
                    @@keyframes blinkEffect {
                                        0% { background-color: #d4edda; }
                                        50% { background-color: #c3e6cb; }
                                        100% { background-color: transparent; }
                                    }
                                `)
                .appendTo("head");

            $('#fileInput').on('change', function () {
                if (this.files && this.files[0]) {
                    if (this.files[0].type.match(/^image\//)) {
                        Upload(this.files[0]);
                    }
                }
            });

            function Upload(file) {
                var fd = new FormData();
                fd.append('file', file);

                $.ajax({
                    url: '/order/upload',
                    data: fd,
                    processData: false,
                    contentType: false,
                    type: 'POST',
                    beforeSend: function () {
                        $('#loadingModal').modal();
                    },
                    success: function (data) {
                        if (data.success) {
                            $("#VerifyImageUrl").val(data.message);
                        } else {
                            toastr.error("Có lỗi xảy ra khi tải ảnh lên.");
                        }
                    },
                    complete: function () {
                        $('#loadingModal').modal('hide');
                    }
                });
            }
        });
    </script>
}
