@using Demo.Web.Helpers
@model Demo.Web.Areas.Admin.Models.PhoneRegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<section class="login-section"
         style="
            min-height: 100vh;
            /* Thay đường dẫn ảnh nền phù hợp */
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">

    <!-- Lớp phủ tối -->
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <!-- Nội dung chính -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Giới thiệu -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Tham gia cùng chúng tôi</h1>
                <p class="mb-4">
                    Đăng ký ngay để khám phá khoá học chất lượng và nâng cao kiến thức đầu tư bất động sản của bạn!
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="text-white">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Cột phải: Form đăng ký -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Đăng ký</h2>

                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("PhoneRegister", "Account", new { ReturnUrl = ViewBag.ReturnUrl ?? "/" }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <!-- Số điện thoại -->
                            <div class="mb-3">
                                @Html.LabelFor(x => x.Phone, "Số điện thoại", new { @class = "form-label" })
                                @Html.TextBoxFor(x => x.Phone, new { @class = "form-control", placeholder = "Nhập số điện thoại *" })
                                @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
                            </div>

                            <!-- Mật khẩu -->
                            <div class="mb-3">
                                @Html.LabelFor(x => x.Password, "Mật khẩu", new { @class = "form-label" })
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu *" })
                                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                            </div>

                            <!-- Xác nhận mật khẩu -->
                            <div class="mb-3">
                                @Html.LabelFor(x => x.PasswordConfirm, "Xác nhận mật khẩu", new { @class = "form-label" })
                                @Html.PasswordFor(x => x.PasswordConfirm, new { @class = "form-control", placeholder = "Nhập lại mật khẩu *" })
                                @Html.ValidationMessageFor(x => x.PasswordConfirm, "", new { @class = "text-danger" })
                            </div>

                            <!-- Nút đăng ký -->
                            <button type="submit" class="btn btn-primary w-100 mb-2">Đăng ký ngay</button>

                            <!-- Đăng ký qua mạng xã hội -->
                            <div class="text-center mt-2">
                                <span>Hoặc đăng ký bằng</span>
                                <ul class="social-profile list-inline d-inline-block mb-0 ms-2">
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://instagram.com/">
                                            <i class="lab la-instagram"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://twitter.com/">
                                            <i class="lab la-twitter"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://facebook.com/">
                                            <i class="lab la-facebook-f"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Chuyển sang trang đăng nhập -->
                            <div class="mt-3 text-center">
                                <p class="mb-0">
                                    Bạn đã có tài khoản?
                                    <a class="link" href="@FriendlyUrl.Login">Đăng nhập</a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
