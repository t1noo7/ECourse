@using Demo.Web.Areas.Admin.Models
@model ManageUserViewModel
@{
    ViewBag.Title = "Đổi Mật Khẩu";
}

@Html.AntiForgeryToken()

<section class="password-reset-section d-flex align-items-center justify-content-center" 
         style="min-height: 100vh; background: url('@Url.Content("~/assets/img/background.jpg")') no-repeat center center; background-size: cover; position: relative;">
    
    <!-- Overlay -->
    <div class="overlay"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5);">
    </div>

    <!-- Form Container -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg border-0 rounded-3">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-3 text-primary fw-bold">Đổi Mật Khẩu</h2>
                        <p class="text-center text-muted">Vui lòng nhập mật khẩu cũ và tạo mật khẩu mới.</p>

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("ChangePassword", "account", FormMethod.Post, new { role = "form" }))
                        {
                            <div class="mb-3">
                                @Html.LabelFor(m => m.OldPassword, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="las la-lock"></i></span>
                                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu cũ" })
                                </div>
                                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="las la-key"></i></span>
                                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu mới" })
                                </div>
                                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="las la-check-circle"></i></span>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Xác nhận mật khẩu mới" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Lưu Thay Đổi</button>

                            <div class="text-center mt-3">
                                <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-primary">
                                    <i class="las la-arrow-left"></i> Quay lại trang chủ
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
