@model Demo.Web.Areas.Admin.Models.LoginViewModel

@{
    ViewBag.Title = "Account login";
}

<!--
    Tuỳ chọn: Sử dụng font-awesome để hiển thị icon mạng xã hội
    <link rel="stylesheet" href="~/Content/fontawesome-all.min.css" />
-->

<section class="login-section"
         style="
            min-height: 100vh;
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">
    <!-- Overlay tối, nếu muốn -->
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <!-- Nội dung chính, đặt position: relative để hiển thị trên overlay -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Welcome Back text + Social icons -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Welcome Back</h1>
                <p class="mb-4">
                    It is a long established fact that a reader will be distracted
                    by the readable content of a page when looking at its layout.
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="text-white">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Cột phải: Form đăng nhập -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Sign in</h2>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl ?? "/" }, FormMethod.Post))
                        {
                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" asp-for="UserName" class="form-control" placeholder="Email Address" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" asp-for="Password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Remember Me</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-2">Sign in now</button>

                            <div class="d-flex justify-content-between">
                                <a href="#">Lost your password?</a>
                            </div>

                            <div class="mt-3 text-center">
                                <small>
                                    By clicking on “Sign in now” you agree to
                                    <a href="#">Terms of Service</a> | <a href="#">Privacy Policy</a>
                                </small>
                            </div>

                            <a class="link" href="phoneregister">Đăng kí sđt</a>
                            <a class="link" href="usernameregister">Đăng kí email</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
