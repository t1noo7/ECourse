@model Demo.Web.Areas.Admin.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập tài khoản";
}

<section class="login-section"
         style="
            min-height: 100vh;
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <!-- Nội dung chính -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Giới thiệu -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Chào mừng trở lại!</h1>
                <p class="mb-4">
                    Đăng nhập ngay để tiếp tục hành trình học tập về đầu tư và kinh doanh bất động sản của bạn.
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="text-white">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Cột phải: Form đăng nhập -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Đăng nhập</h2>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl ?? "/" }, FormMethod.Post))
                        {
                            <div class="mb-3">
                                <label for="account" class="form-label">Email hoặc Số điện thoại</label>
                                <input type="text" asp-for="UserName" class="form-control" placeholder="Nhập email hoặc số điện thoại" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Mật khẩu</label>
                                <input type="password" asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-2">Đăng nhập ngay</button>

                            <div class="d-flex justify-content-between">
                                <a href="#">Quên mật khẩu?</a>
                            </div>

                            <div class="mt-3 text-center">
                                <small>
                                    Khi đăng nhập, bạn đồng ý với
                                    <a href="#">Điều khoản sử dụng</a> | <a href="#">Chính sách bảo mật</a>
                                </small>
                            </div>

                            <div class="mt-4 text-center">
                                <span>Bạn chưa có tài khoản?</span>
                                <div class="d-flex justify-content-center mt-3">
                                    <a href="@Url.Action("PhoneRegister", "Account", new { returnUrl = ViewBag.ReturnUrl ?? "/"})" class="btn btn-outline-primary me-2">
                                        <i class="fas fa-phone-alt"></i> Đăng ký bằng số điện thoại
                                    </a>
                                    <a href="usernameregister" class="btn btn-outline-success">
                                        <i class="fas fa-envelope"></i> Đăng ký bằng email
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
