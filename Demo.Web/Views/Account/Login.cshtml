@model Demo.Web.Areas.Admin.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng Nhập Tài Khoản";
}

<section class="login-section"
         style="
            min-height: 100vh;
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">
    <!-- Lớp phủ nền tối -->
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Chào mừng và Mạng xã hội -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Chào Mừng Trở Lại</h1>
                <p class="mb-4">
                    Đây là nền tảng giúp bạn phát triển bản thân và kinh doanh bền vững thông qua các khóa học chất lượng.
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="me-3 text-white">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="text-white">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Cột phải: Form đăng nhập -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Đăng Nhập</h2>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl ?? "/" }, FormMethod.Post))
                        {
                            <div class="mb-3">
                                <label for="email" class="form-label" >Tên Đăng Nhập (Email)</label>
                                <input type="text" asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Mật Khẩu</label>
                                <input type="password" asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
@*                             <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div> *@
                            <button type="submit" class="btn btn-primary w-100 mb-2">Đăng Nhập</button>

@*                             <div class="d-flex justify-content-between">
                                <a href="#">Quên mật khẩu?</a>
                            </div> *@

                            <div class="register-links text-center mt-3">
                                <a class="btn btn-primary w-100 mb-2" href="usernameregister?returnUrl=@ViewBag.ReturnUrl">
                                    Đăng ký
                                </a>

                            </div>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .register-links {
        font-size: 1rem;
        font-weight: 500;
    }

    .register-link {
        color: #007bff;
        text-decoration: none;
        transition: color 0.3s ease-in-out;
    }

        .register-link:hover {
            color: #0056b3;
            text-decoration: underline;
        }
</style>
