@using Demo.Web.Helpers
@model Demo.Web.Areas.Admin.Models.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<section class="login-section"
         style="
            min-height: 100vh;
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">
    <!-- Lớp phủ tối -->
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <!-- Nội dung chính -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Giới thiệu -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Tham gia cộng đồng của chúng tôi</h1>
                <p class="mb-4">
                    Đăng ký ngay để tiếp cận các khóa học bất động sản chuyên sâu và những kiến thức đầu tư giá trị.
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white"><i class="lab la-instagram"></i></a>
                    <a href="#" class="me-3 text-white"><i class="lab la-twitter"></i></a>
                    <a href="#" class="me-3 text-white"><i class="lab la-facebook-f"></i></a>
                </div>
            </div>

            <!-- Cột phải: Form đăng ký -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Đăng ký</h2>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("UsernameRegister", "Account", new { ReturnUrl = ViewBag.ReturnUrl ?? "/" }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                @Html.LabelFor(x => x.Email, "Email", new { @class = "form-label" })
                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "Nhập email để kích hoạt tài khoản *" })
                                @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(x => x.Password, "Mật khẩu", new { @class = "form-label" })
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu *" })
                                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(x => x.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label" })
                                @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu *" })
                                @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mb-2">Đăng ký ngay</button>

@*                             <div class="text-center mt-2">
                                <span>Hoặc đăng ký bằng</span>
                                <ul class="social-profile list-inline d-inline-block mb-0 ms-2">
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://instagram.com/">
                                            <i class="lab la-instagram"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://twitter.com/">
                                            <i class="lab la-twitter"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://facebook.com/">
                                            <i class="lab la-facebook-f"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>  *@

                            <div class="mt-3 text-center">
                                <p class="mb-0">Bạn đã có tài khoản? <a class="link" href="@FriendlyUrl.Login">Đăng nhập</a></p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
