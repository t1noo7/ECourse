@model Demo.Web.Areas.Admin.Models.RegisterViewModel

@{
    ViewBag.Title = "Account Register";
}

<section class="login-section"
         style="
            min-height: 100vh;
            background: url('@Url.Content("~/assets/img/carousel-1.jpg")') no-repeat center center;
            background-size: cover;
            position: relative;
         ">
    <!-- Overlay mờ -->
    <div class="overlay"
         style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
         ">
    </div>

    <!-- Nội dung chính hiển thị trên overlay -->
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row align-items-center" style="min-height: 100vh;">
            <!-- Cột trái: Giới thiệu & Social icons -->
            <div class="col-lg-6 text-white d-flex flex-column justify-content-center mb-5 mb-lg-0">
                <h1 class="mb-3 fw-semi-bold">Join Our Community</h1>
                <p class="mb-4">
                    Unlock a world of opportunities by registering with us. Start your journey with exclusive courses and insights.
                </p>
                <div class="social-icons">
                    <a href="#" class="me-3 text-white"><i class="lab la-instagram"></i></a>
                    <a href="#" class="me-3 text-white"><i class="lab la-twitter"></i></a>
                    <a href="#" class="me-3 text-white"><i class="lab la-facebook-f"></i></a>
                </div>
            </div>

            <!-- Cột phải: Form Register -->
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Register</h2>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                        @using (Html.BeginForm("UsernameRegister", "Account", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                @Html.LabelFor(x => x.UserName, new { @class = "form-label" })
                                @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", placeholder = "Username *" })
                                @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(x => x.Email, new { @class = "form-label" })
                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "Email to activate *" })
                                @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(x => x.Password, new { @class = "form-label" })
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Password *" })
                                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(x => x.ConfirmPassword, new { @class = "form-label" })
                                @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm Password *" })
                                @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mb-2">Register</button>

                            <div class="text-center mt-2">
                                <span>Or Register With</span>
                                <ul class="social-profile list-inline d-inline-block mb-0 ms-2">
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://instagram.com/">
                                            <i class="lab la-instagram"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://twitter.com/">
                                            <i class="lab la-twitter"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a target="_blank" href="https://facebook.com/">
                                            <i class="lab la-facebook-f"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="mt-3 text-center">
                                <p class="mb-0">Already Have An Account? <a class="link" href="account/login">Login</a></p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
