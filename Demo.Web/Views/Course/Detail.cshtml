@using Demo.Core.Models
@model Course
@{
    var lesson = ViewBag.Lesson as List<Demo.Core.Models.Lesson>;
}

<section class="course-details-wrap py-5">
    <div class="container">
        <div class="row gx-5">
            <!-- Thông tin khóa học -->
            <div class="col-lg-8">
                <div class="course-details shadow rounded p-4">
                    <div class="course-details-img text-center mb-4">
                        <img src="@Model.Image" alt="Khóa học Đầu tư chứng khoán" class="img-fluid rounded">
                    </div>
                    <h2 class="mb-3">@Model.Title</h2>
                    <p>@Html.Raw(@Model.Description)</p>
                    <button class="btn btn-success w-100" onclick="joinCourse('@Model.Id')">Bắt đầu học ngay</button>
                    <div class="d-flex justify-content-between bg-light p-3 rounded">
                        <span><i class="fa-solid fa-star"></i> 4.9</span>
                        <span><i class="fa-solid fa-user"></i> 4890 học viên</span>
                        @if(Model.DiscountPrice > 0 && Model.DiscountPrice != null)
                        {
                            <span><i class="fa-solid fa-dollar-sign"></i> @Model.DiscountPrice</span>
                        }
                        else
                        {
                            <span><i class="fa-solid fa-dollar-sign"></i> @Model.Price</span>
                        }
                    </div>

                    <!-- Lộ trình khóa học -->
                    <h4 class="mt-4">Lộ trình khóa học</h4>
                    <ul class="list-group list-group-flush">
                        @for (int i = 0; i < lesson.Count; i++)
                        {
                            <li class="list-group-item lesson-item">
                                <span class="lesson-number">@((i + 1))</span> @lesson[i].Title
                            </li>
                        }
                    </ul>

                    <!-- Lợi ích nhận được -->
                    <div class="mt-4 p-3 border rounded bg-light">
                        <h4>Bạn sẽ học được</h4>
                        <ul class="list-unstyled">
                            <li><i class="fa-solid fa-check-circle text-success"></i> Hiểu cách thị trường chứng khoán hoạt động</li>
                            <li><i class="fa-solid fa-check-circle text-success"></i> Xác định các chiến lược đầu tư phù hợp</li>
                            <li><i class="fa-solid fa-check-circle text-success"></i> Đọc hiểu báo cáo tài chính</li>
                            <li><i class="fa-solid fa-check-circle text-success"></i> Quản lý rủi ro trong đầu tư</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Sidebar khóa học -->
            <div class="col-lg-4">
                <div class="course-details-widget bg-white shadow p-4 rounded">
                    @await Component.InvokeAsync("PopularCourses")
                    @await Component.InvokeAsync("CourseCategory")
                </div>

                <!-- Đánh giá khóa học -->
                <div class="mt-4">
                    <h4>Đánh giá khóa học</h4>
                    <div class="d-flex align-items-center border-bottom py-3">
                        <img src="~/assets/img/testimonial-1.jpg" alt="User" class="rounded-circle me-3" width="50">
                        <div>
                            <h6 class="mb-1">Lê Hải</h6>
                            <p class="text-muted">Tuyệt vời!</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-3">
                        <img src="~/assets/img/testimonial-2.jpg" alt="User" class="rounded-circle me-3" width="50">
                        <div>
                            <h6 class="mb-1">Trung Kiên</h6>
                            <p class="text-muted">Khóa học rất hữu ích</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-3">
                        <img src="~/assets/img/testimonial-3.jpg" alt="User" class="rounded-circle me-3" width="50">
                        <div>
                            <h6 class="mb-1">Thu Phương</h6>
                            <p class="text-muted">Giảng viên dạy dễ hiểu!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .lesson-item {
        display: flex;
        align-items: center;
        gap: 10px; 
        cursor: pointer;
        border-bottom: 1px solid #ddd; 
        padding: 10px 0;
    }

    .lesson-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        background-color: #007bff; 
        color: #fff;
        font-weight: bold;
        border-radius: 50%; 
        text-align: center;
        font-size: 14px;
    }

</style>

<script>
    function joinCourse(courseId) {
        window.location.href = '/Order/Checkout?courseId=' + courseId;
    }
</script>
