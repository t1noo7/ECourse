@using Demo.Core.Models;
@using Demo.Web.Helpers
@model List<Course>

<section class="breadcrumb-wrap  br-bg-4">
    <div class="overlay op-6 bg-black"></div>
    <div class="container">
        <div class="row">
            <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1 col-md-10 offset-md-1">
                <div class="breadcrumb-title">
                    <h2>Our Courses</h2>
                    <ul class="breadcrumb-menu">
                        <li><a href="index.html">Home </a></li>
                        <li>Courses</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Course Details -->
<section class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <img src="img/course-image.jpg" class="img-fluid rounded" alt="Course Image">
            <h2 class="mt-4">About This Course</h2>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio.</p>
        </div>
        <div class="col-lg-4">
            <div class="bg-light p-4 rounded">
                <h3>Course Features</h3>
                <ul>
                    <li>Duration: 4 weeks</li>
                    <li>Level: Beginner</li>
                    <li>Price: Free</li>
                </ul>
                <button class="btn btn-primary w-100">Enroll Now</button>
            </div>
        </div>
    </div>
</section>