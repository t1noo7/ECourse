@using Demo.Web.Helpers

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s" style="min-height: 400px;">
                <div class="position-relative h-100">
                    <img class="img-fluid position-absolute w-100 h-100" src="~/assets/img/about.jpg" alt="Ảnh cá nhân" style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                <h6 class="section-title bg-white text-start text-primary pe-3">Giới Thiệu</h6>
                <h1 class="mb-4">Xin chào, tôi là [Tên Của Bạn]</h1>
                <p class="mb-4">Tôi là một [chuyên gia/lập trình viên/giảng viên] với đam mê chia sẻ kiến thức và giúp đỡ người khác phát triển kỹ năng của mình. Với nhiều năm kinh nghiệm trong lĩnh vực [lĩnh vực chuyên môn], tôi đã giúp hàng trăm học viên tiếp cận kiến thức một cách dễ dàng và hiệu quả.</p>
                <p class="mb-4">Hiện tại, tôi đang giảng dạy và cung cấp các khóa học về [các lĩnh vực đào tạo của bạn], giúp học viên nâng cao kỹ năng và ứng dụng thực tế trong công việc.</p>
                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Kinh nghiệm giảng dạy thực tế</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Khóa học chất lượng cao</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Học tập linh hoạt, mọi lúc mọi nơi</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Chứng chỉ hoàn thành khóa học</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Hỗ trợ học viên tận tình</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Kết nối và chia sẻ kiến thức</p>
                    </div>
                </div>
                <a class="btn btn-primary py-3 px-5 mt-2" href="@FriendlyUrl.CourseList()">Xem các khóa học</a>
            </div>
        </div>
    </div>
</div>
