@using Demo.Core.Models
@using Demo.Web.Helpers
@model List<Course>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Khóa Học</h6>
            <h1 class="mb-5">Khóa Học Phổ Biến</h1>
        </div>
        <div class="row g-4 justify-content-center">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="course-item bg-light">
                            <div class="position-relative overflow-hidden">
                                <img class="img-fluid" src="@item.Image" alt="@item.Title">
                                <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                                    <a href="@FriendlyUrl.CourseDetail(item.FriendlyUrl)" class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end" style="border-radius: 30px 0 0 30px;">Xem Thêm</a>
                                    <a href="javascript:void(0)" class="flex-shrink-0 btn btn-sm btn-primary px-3"
                                       style="border-radius: 0 30px 30px 0;"
                                       onclick="joinCourse('@item.Id')">Tham Gia Ngay</a>

                                </div>
                            </div>
                            <div class="text-center p-4 pb-0">
                                @if (item.DiscountPrice != null)
                                {
                                    <h3 class="mb-0">@item.DiscountPrice?.ToString("#,##0 VNĐ")</h3>
                                }
                                else
                                {
                                    <h3 class="mb-0">@item.Price.ToString("#,##0 VNĐ")</h3>
                                }
                                <div class="mb-3">
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small class="fa fa-star text-primary"></small>
                                    <small>(123)</small>
                                </div>
                                <h5 class="mb-4">@item.Title</h5>
                            </div>
                            <div class="d-flex border-top">
                                <small class="flex-fill text-center border-end py-2"><i class="fa fa-user-tie text-primary me-2"></i>Nguyễn Văn A</small>
                                <small class="flex-fill text-center border-end py-2"><i class="fa fa-clock text-primary me-2"></i>2 Giờ</small>
                                <small class="flex-fill text-center py-2"><i class="fa fa-user text-primary me-2"></i>30 Học Viên</small>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Không có khóa học nào đang diễn ra</p>
            }
        </div>
    </div>
</div>

<script>
    function joinCourse(courseId) {
        window.location.href = '/Order/Checkout?courseId=' + courseId;
    }
</script>
