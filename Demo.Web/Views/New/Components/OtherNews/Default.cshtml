@using Demo.Web.Extensions
@using Demo.Web.Helpers
@model List<Demo.Core.Models.New>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Tin Khác</h6>
        </div>
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="team-item bg-light">
                            <div class="overflow-hidden">
                                <img class="img-fluid" src="@item.Image" alt="@item.Title">
                            </div>
                            <div class="text-center p-4">
                                <h5 class="mb-0">
                                    <a href="@FriendlyUrl.NewDetails(item.FriendlyUrl)" class="text-dark">
                                        @item.Title
                                    </a>
                                </h5>
                                <small class="text-muted">By @item.Author - @item.Created.ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="d-flex justify-content-center py-2">
                                <a href="@FriendlyUrl.NewDetails(item.FriendlyUrl)" class="btn btn-primary btn-sm">Đọc thêm</a>
                            </div>
                        </div>
                    </div>
                }
            } else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Không có tin tức nào.</p>
                </div>
            }
        </div>
    </div>
</div>
