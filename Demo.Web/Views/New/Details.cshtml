@using Demo.Web.Components;
@using Demo.Web.Extensions
@using Demo.Web.Helpers
@model Demo.Core.Models.New

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

<!-- Header Start -->
@section Banner {
    <div class="container-fluid bg-primary py-5 mb-5 page-header text-center">
        <div class="container py-5">
            <h1 class="display-3 text-white animated fadeInDown">Tin Tức</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a class="text-white" href="/">Trang chủ</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>
}
<!-- Header End -->

@if (Model != null)
{
    <div class="sic_the_content clearfix">
        @Html.Raw(Model.Content)
    </div>
    @await Component.InvokeAsync("OtherNews",
                                     new
                                     {
                                         currentNewId = Model.Id,
                                         currentNewCreatedDate = Model.Created
                                     }
                                     )
}
