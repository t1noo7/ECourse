@using Demo.Core.Models
@model List<Chapter>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách học phần";
    var searchModel = ViewBag.SearchModel as Demo.Application.Models.ChapterFilter;
}

<div class="card mt-2 mb-2 shadow-base" id="searchBox">
    <div class="card-body pb-0">
        <partial name="_SearchChapter" model="@searchModel" />
    </div>
</div>

@section Button {
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})"
       class="btn btn-primary btn-sm pull-right"><i class="anticon anticon-plus-circle m-r-5"></i>Thêm mới</a>
}
<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <thead class="thead-gray">
                <tr>
                    <th>STT</th>
                    <th>
                        Tên học phần
                    </th>
                    <th>
                        Ngày tạo
                    </th>
                    <th>
                        Trạng thái
                    </th>
                    <th></th>
                </tr>
            </thead>
            @{
                var stt = 1;
                foreach (var item in Model.OrderBy(x => x.Created))
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>
                            <a href="@Url.Action("Index", "Lesson", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})">@item.Title</a>
                        </td>
                        <td>@item.Created</td>
                        <td>
                            <a href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-success m-r-5"><i class="fas fa-pencil-alt"></i></a>
                            <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-danger m-r-5" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </table>
        <div class="text-center">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>