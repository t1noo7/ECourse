@model Demo.Common.Models.Pagination<Demo.Core.Models.New>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách tin tức";
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i>Home
            </a>
            <span class="breadcrumb-item active">Danh sách Tin tức</span>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh sách Tin tức</h4>
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})"
       class="btn btn-primary">
        <i class="anticon anticon-plus-circle m-r-5"></i>Thêm Mới
    </a>
</div>

<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <thead style="background-color: #e3e6f0;">
                <tr>
                    <th>STT</th>
                    <th>
                        Tiêu Đề
                    </th>
                    <th>
                        Ảnh
                    </th>
                    <th>
                        Tác Giả
                    </th>
                    <th>
                        Ngày Tạo
                    </th>
                    <th>
                        Trạng Thái
                    </th>
                    <th>Hành động</th>
                </tr>
            </thead>
            @{
                var stt = (Model.PageIndex - 1) * Model.PageSize + 1;
                foreach (var item in Model.Items.OrderByDescending(m => m.Created))
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>@item.Title</td>
                        <td>
                            <img src="@item.Image" class="img64x64" />
                        </td>
                        <td>@item.CreatedBy</td>
                        <td>@item.Created</td>
                        <td>
                            <a href="@Url.Action("ChangeStatus", new { id = item.Id, status = !item.Status })" onclick="return confirm('Bạn có chắc chắn muốn đổi trạng thái?')" class="text-info">
                                @if (item.Status == false)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-danger badge-dot m-r-10"></div>
                                        <div>Không Hoạt Động</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-success badge-dot m-r-10"></div>
                                        <div>Hoạt Động</div>
                                    </div>
                                }
                            </a>
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-success m-r-5 btn-sm"><i class="fas fa-pencil-alt"></i></a>
                            <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-danger m-r-5 btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </table>
        <partial name="_Pagination" model="Model" view-data="ViewData" />
    </div>
</div>