@using Demo.Core.Models
@using Demo.Web.Extensions
@model Lesson

@{
    ViewData["Title"] = "Thiết lập Bài giảng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var courses = ViewBag.Courses as List<Demo.Core.Models.Course>;
    var classes = ViewBag.Classes as List<Demo.Core.Models.Class>;
}

<div class="card mt-2 mb-2 shadow-base">
    <div class="card-body pb-0">
        <form method="post" enctype="multipart/form-data" asp-controller="Lesson" asp-action="Edit" id="editForm">
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Created)
            @Html.HiddenFor(m => m.CreatedBy)
            @Html.HiddenFor(m => m.FriendlyUrl)
            @Html.HiddenFor(m => m.VideoPath)
            @Html.HiddenFor(m => m.CourseId)
            @Html.HiddenFor(m => m.ClassId)
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <p>Model ID: @Model.Id</p>
            <div class="row mb-lg-2">
                <div class="col-md-4 col-sm-6 search-item">
                    @Html.LabelFor(m => m.Title) @Html.RequireLabel()
                    @Html.TextBoxFor(m => m.Title, new
                        {
                            Class = "form-control form-control-smy",
                            required = "required"
                        })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.VideoPath, new { @class = "form-label fw-bold" })

                <div class="input-group">
                    <label class="btn btgreen text-white" for="videoInput">Chọn video</label>
                    <input type="file" id="videoInput" name="videoInput" accept="video/*" style="display:none" />
                </div>

                <small class="form-text text-muted">Bạn có thể tải lên video hoặc nhập URL YouTube bên dưới.</small>
            </div>


            <div class="form-group">
                @Html.LabelFor(m => m.YouTubeUrl)
                <input type="text" class="form-control" asp-for="YouTubeUrl" id="youtube-url">
            </div>
            <div class="form-group">
                <label class="font-weight-semibold">Preview</label>
                <div id="youtube-preview">
                    @if (!string.IsNullOrEmpty(Model.VideoPath))
                    {
                        <video width="560" height="315" controls>
                            <source src="@Url.Content(Model.VideoPath)" type="video/mp4">
                            Trình duyệt của bạn không hỗ trợ video.
                        </video>
                    } else if (!string.IsNullOrEmpty(Model.YouTubeUrl))
                    {
                        var embedUrl = "";
                        var match = System.Text.RegularExpressions.Regex.Match(Model.YouTubeUrl, @"(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)");
                        if (match.Success)
                        {
                            embedUrl = $"https://www.youtube.com/embed/{match.Groups[1].Value}";
                        }
                        if (!string.IsNullOrEmpty(embedUrl))
                        {
                            <iframe width="560" height="315"
                                    src="@embedUrl"
                                    frameborder="0" allowfullscreen>
                            </iframe>
                        } else
                        {
                            <span class='text-danger'>URL YouTube không hợp lệ</span>
                        }
                    }
                </div>
            </div>
            <div class="row mb-lg-2">
                <div class="col-md-4 col-sm-6 search-item">
                    @Html.LabelFor(m => m.CourseId)
                    <select class="form-control" id="courseSelection" name="CourseId" required>
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var course in courses ?? new List<Course>())
                        {
                            <option value="@course.Id" selected="@(Model.CourseId == course.Id ? "selected" : null)">
                                @course.Title
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-lg-2">
                <div class="col-md-4 col-sm-6 search-item">
                    @Html.LabelFor(m => m.ClassId)
                    <select class="form-control" id="classSelection" name="ClassId" required>
                        <option value="">-- Chọn lớp học --</option>
                        @foreach (var classItem in classes ?? new List<Class>())
                        {
                            <option value="@classItem.Id" selected="@(Model.ClassId == classItem.Id ? "selected" : null)">
                                @classItem.ClassName
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-lg-2">
                <div class="col-md-12 col-sm-12 search-item">
                    @Html.LabelFor(m => m.Description) @Html.RequireLabel()
                    @Html.TextAreaFor(m => m.Description, new
                        {
                            Class = "form-control form-control-smy h-100"
                        })
                </div>
            </div>
            <div class="row mb-lg-2">
                <div class="col-md-12 col-sm-12 search-item">
                    @Html.LabelFor(m => m.Content) @Html.RequireLabel()
                    @Html.TextAreaFor(m => m.Content, new
                        {
                            Class = "form-control form-control-smy h-100",
                            required =
                             "required"
                        })
                </div>
            </div>
            <hr />
            <div class="mb-2">
                <button class="btn btn-success" type="button" onclick="$('#editForm').submit()">Lưu</button>
                <a href="@Context.Request.Query["returnUrl"]" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="https://cdn.tiny.cloud/1/mbx1d96tuje4gp42frlv3fq1gpxrftgpiavfttwwubl2fn70/tinymce/6/tinymce.min.js"
            referrerpolicy="origin"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var youtubeInput = document.getElementById("youtube-url");
            var previewContainer = document.getElementById("youtube-preview");

            function getEmbedUrl(url) {
                var videoId = "";
                var match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)/);
                if (match) {
                    videoId = match[1];
                }
                return videoId ? `https://www.youtube.com/embed/${videoId}` : "";
            }

            function updatePreview() {
                var url = youtubeInput.value.trim();
                var embedUrl = getEmbedUrl(url);

                if (!embedUrl) {
                    previewContainer.innerHTML = "<span class='text-danger'>URL không hợp lệ</span>";
                    return;
                }

                previewContainer.innerHTML = `
                                        <iframe width="560" height="315"
                                            src="${embedUrl}"
                                            frameborder="0" allowfullscreen>
                                        </iframe>`;
            }

            youtubeInput.addEventListener("input", updatePreview);

            // Khi load trang, nếu có URL sẵn thì cập nhật preview
            if (youtubeInput.value.trim() !== "") {
                setTimeout(updatePreview, 500);
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const videoInput = document.getElementById("videoInput");
            const youtubeInput = document.getElementById("youtube-url");
            const previewContainer = document.getElementById("youtube-preview");

            videoInput.addEventListener("change", function () {
                if (videoInput.files && videoInput.files[0]) {
                    const file = videoInput.files[0];
                    const fileUrl = URL.createObjectURL(file);

                    previewContainer.innerHTML = `
                                    <video width="560" height="315" controls>
                                        <source src="${fileUrl}" type="${file.type}">
                                        Trình duyệt của bạn không hỗ trợ video.
                                    </video>
                                `;

                    // Nếu người dùng chọn video file, thì xóa nội dung ô YouTube để tránh nhầm lẫn
                    youtubeInput.value = "";
                }
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(function () {
                common.initTinyMce('#Content');
                common.initTinyMce('#Description');
            }, 1000);
        });
    </script>
}