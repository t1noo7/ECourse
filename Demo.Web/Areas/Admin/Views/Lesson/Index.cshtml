@using Demo.Web.Areas.Admin.Models
@model List<LessonViewModel>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách bài giảng";
    var searchModel = ViewBag.SearchModel as Demo.Application.Models.LessonFilter;
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i>Home
            </a>
            <span class="breadcrumb-item active">Danh sách Bài giảng</span>
        </nav>
    </div>
</div>
<div class="card mt-2 mb-2 shadow-base" id="searchBox">
    <div class="card-body pb-0">
        <partial name="_SearchLesson" model="@searchModel" />
    </div>
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh sách Bài giảng</h4>
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-primary">
        <i class="anticon anticon-plus-circle m-r-5"></i>Thêm Mới
    </a>
</div>

<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <tr>
                <th>STT</th>
                <th>
                    Tên bài giảng
                </th>
                <th>
                    Thuộc khóa học
                </th>
                <th>
                    Ngày tạo
                </th>
                <th></th>
            </tr>

            @{
                var stt = 1;
                foreach (var item in Model)
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>
                            @item.Title
                        </td>
                        <td>
                            @item.CourseName
                        </td>
                        <td>@item.Created</td>
                        <td>
                            <a href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-success m-r-5 btn-sm"><i class="fas fa-pencil-alt"></i></a>
                            <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-danger m-r-5 btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </table>
        <div class="text-center">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>