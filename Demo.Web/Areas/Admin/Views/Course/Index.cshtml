@using Demo.Core.Models
@model List<Course>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách khoá học";
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i>Home
            </a>
            <span class="breadcrumb-item active">Danh sách Khóa học</span>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh sách Khóa học</h4>
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})"
       class="btn btn-primary btn-sm">
        <i class="anticon anticon-plus-circle m-r-5"></i>Thêm Mới
    </a>
</div>

<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <tr>
                <th>STT</th>
                <th>
                    Tiêu Đề Khoá Học
                </th>
                <th>
                    Ảnh
                </th>
                <th>
                    Giá
                </th>
                <th>
                    Ngày tạo
                </th>
                <th>
                    Trạng thái
                </th>
                <th></th>
            </tr>

            @{
                var stt = 1;
                foreach (var item in Model.OrderBy(x => x.Created))
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>
                            <a href="@Url.Action("Index", "Lesson", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})">@item.Title</a>
                        </td>
                        <td>
                            <img src="@item.Image" class="img64x64" />
                        </td>
                        <td>
                            @if (item.DiscountPrice > 0 && item.DiscountPrice != null)
                            {
                                @item.DiscountPrice
                            } else
                            {
                                @item.Price
                            }
                        </td>
                        <td>@item.Created</td>
                        <td>
                            <a href="@Url.Action("ChangeStatus", new { id = item.Id, status = !item.Status })" onclick="return confirm('Bạn có chắc chắn muốn đổi trạng thái?')" class="text-info">
                                @if (item.Status == false)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-danger badge-dot m-r-10"></div>
                                        <div>Không Hoạt Động</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-success badge-dot m-r-10"></div>
                                        <div>Hoạt Động</div>
                                    </div>
                                }
                            </a>
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-success m-r-5"><i class="fas fa-pencil-alt"></i></a>
                            <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-danger m-r-5" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </table>
    </div>
</div>