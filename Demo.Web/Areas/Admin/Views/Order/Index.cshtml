@using Demo.Core.Models
@model List<Order>
@using Microsoft.AspNetCore.Http.Extensions
@using Demo.Common.Extensions
@{
    ViewData["Title"] = "Danh sách đơn hàng";
    var searchModel = ViewBag.SearchModel as Demo.Application.Models.OrderFilter;
}
<div class="card mt-2 mb-2 shadow-base" id="searchBox">
    <div class="card-body pb-0">
        <partial name="_SearchOrders" model="@searchModel" />
    </div>
</div>
<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <tr>
                <th>STT</th>
                <th>
                    ID Đơn hàng
                </th>
                <th>
                    Tên khách hàng
                </th>
                <th>
                    Khoá học đăng ký
                </th>
                <th>
                    Giá (VNĐ)
                </th>
                <th>
                    Xác thực thanh toán
                </th>
                <th>
                    Ngày tạo
                </th>
                <th>
                    Trạng thái
                </th>
            </tr>

            @{
                var stt = 1;
                foreach (var item in Model.OrderByDescending(m => m.Created))
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>
                            <a
                                href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})">@item.Code</a>
                        </td>
                        <td>
                            @item.CustomerName
                        </td>
                        <td>
                            @item.Course?.Title
                        </td>
                        <td>
                            @item.Price.ToString("N0")
                        </td>
                        @if (string.IsNullOrEmpty(item.VerifyImageUrl))
                        {
                            <td>
                                <span class="badge badge-danger">Chưa xác thực</span>
                            </td>
                        }
                        else
                        {
                            <td>
                                <img src="@item.VerifyImageUrl" class="img64x64" style="cursor: zoom-in;"
                                    onclick="showImageZoomCinema('@item.VerifyImageUrl')" />
                            </td>
                        }
                        <td>
                            @item.Created.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @item.Status.GetEnumDescription()
                        </td>

                    </tr>
                }
            }
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function showImageZoomCinema(src) {
            // Nếu overlay đã tồn tại thì không thêm nữa
            if (document.getElementById("imageOverlayZoom")) return;

            const overlay = document.createElement("div");
            overlay.className = "image-overlay-cinema";
            overlay.id = "imageOverlayZoom";

            const img = document.createElement("img");
            img.src = src;
            img.alt = "Zoomed Image";

            overlay.appendChild(img);

            overlay.addEventListener("click", () => {
                overlay.remove();
                document.documentElement.classList.remove("zoom-lock");
            });

            // Escape để tắt
            const escClose = function (e) {
                if (e.key === "Escape") {
                    overlay.remove();
                    document.documentElement.classList.remove("zoom-lock");
                    document.removeEventListener("keydown", escClose);
                }
            };
            document.addEventListener("keydown", escClose);

            // THAY ĐỔI Ở ĐÂY: thêm vào document.body TRỰC TIẾP
            document.body.appendChild(overlay);
            document.documentElement.classList.add("zoom-lock");
        }
    </script>
}