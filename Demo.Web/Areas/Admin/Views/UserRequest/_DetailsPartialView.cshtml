@model Demo.Core.Models.UserRequest

<div class="modal-header">
    <h5 class="modal-title">Chi tiết phản hồi</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p><strong>Tên:</strong> @Model.FullName</p>
    <p><strong>Tuổi:</strong> @Model.Age</p>
    <p><strong>Lĩnh vực kinh doanh:</strong> @Model.BusinessField</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Điện thoại:</strong> @Model.Phone</p>
    <p><strong>Ngày tạo:</strong> @Model.Created.ToString("dd/MM/yyyy HH:mm")</p>
    <p><strong>Nội dung:</strong> @Model.Difficulty</p>
</div>