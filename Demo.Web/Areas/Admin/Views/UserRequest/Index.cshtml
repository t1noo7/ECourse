@model Demo.Common.Models.Pagination<Demo.Core.Models.UserRequest>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách phản hồi khách hàng";
}

<style>
    .modal-header {
        background-color: #4e73df;
        color: white;
        border-bottom: 1px solid #dee2e6;
    }

    .modal-title {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .modal-body {
        font-size: 1rem;
        line-height: 1.6;
    }

        .modal-body p {
            margin-bottom: 0.75rem;
            display: flex;
        }

        .modal-body strong {
            width: 120px;
            color: #343a40;
        }

    .modal-content {
        border-radius: 10px;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.15);
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 1.2rem;
        color: white;
    }

    .modal-dialog-centered {
        display: flex;
        align-items: center;
        min-height: calc(100% - 1rem);
    }

    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out;
        transform: translateY(0); /* Không bị lệch */
    }
</style>


<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i>Home
            </a>
            <span class="breadcrumb-item active">Danh sách Phản hồi khách hàng</span>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh sách Phản hồi khách hàng</h4>
</div>

<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <tr>
                <th>STT</th>
                <th>
                    Tên
                </th>
                <th>
                    Email
                </th>
                <th>
                    Số Điện Thoại
                </th>
                <th>
                    Ngày Tạo
                </th>
                <th>
                    Trạng Thái
                </th>
                <th></th>
            </tr>

            @{
                var stt = (Model.PageIndex - 1) * Model.PageSize + 1;
                foreach (var item in Model.Items.OrderByDescending(m => m.Created))
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.Created</td>
                        <td>
                            <a href="@Url.Action("ChangeStatus", new { id = item.Id, status = !item.Status })" onclick="return confirm('Bạn có chắc chắn muốn đổi trạng thái?')" class="text-info">
                                @if (item.Status == false)
                                {
                                    <div class="d-flex align-items-center">
                                        <div>Chưa Xử Lý</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div>Đã Xử Lý</div>
                                    </div>
                                }
                            </a>
                        </td>
                        <td>
                            <a href="javascript:void(0)" class="btn btn-secondary m-r-5 btn-sm" onclick="loadDetails('@item.Id')"><i class="far fa-file-alt"></i></a>
                            <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-danger m-r-5 btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </table>
        <partial name="_Pagination" model="Model" view-data="ViewData" />
    </div>
</div>



<div class="modal fade" id="userRequestModal" tabindex="-1" aria-labelledby="userRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="userRequestModalContent">
            <!-- Nội dung từ Partial sẽ được load vào đây -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadDetails(id) {
            $.ajax({
                url: '@Url.Action("Details", "UserRequest", new { area = "Admin" })/' + id,
                type: 'GET',
                success: function (result) {
                    $('#userRequestModalContent').html(result);
                    $('#userRequestModal').modal('show');
                },
                error: function () {
                    alert('Không thể tải chi tiết phản hồi.');
                }
            });
        }
    </script>
}
