@model IEnumerable<Demo.Core.Models.User>
@using Microsoft.AspNetCore.Http.Extensions
@using Demo.Core.Permission
@inject Demo.Core.Services.IUserGroupManager _roleManager
@{
    ViewBag.Title = "Danh sách khách hàng";
    var searchModel = ViewBag.SearchModel as Demo.Core.Permission.FilterModel;
    var isAdmin = _roleManager.HasPermission(User.Identity.Name, RoleList.Admin);
    searchModel.isAdmin = isAdmin;
}

<div class="card mt-2 mb-2 shadow-base" id="searchBox">
    <div class="card-body pb-0">
        <partial name="_SearchCustomers" model="@searchModel" />
    </div>
</div>
<div class="card mt-2 mb-2 shadow-base">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <tr>
                <th>STT</th>
                <th>
                    Tên Người Dùng
                </th>
                <th>
                    Email
                </th>
                <th>
                    Số Điện Thoại
                </th>
                <th>Tình trạng</th>
            </tr>

            @{
                var stt = 1;
                foreach (var item in Model)
                {
                    <tr class="stat even">
                        <td class="ac">
                            @(stt++)
                        </td>
                        <td>
                            <a href="@Url.Action("CustomerDetails", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})">@item.UserName @item.FullName</a>
                        </td>
                        <td>
                            @item.Email
                        </td>
                        <td>
                            @item.PhoneNumber
                        </td>
                        <td>
                            @if (isAdmin)
                            {
                                <a href="@Url.Action("LockUser", new { id = item.Id, isLocked = !item.IsLocked })" onclick="return confirm('Bạn có chắc chắn muốn @(item.IsLocked ? "mở khóa" : "khóa người dùng")?')" class="text-info">
                                    @if (item.IsLocked == true)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-danger badge-dot m-r-10"></div>
                                            <div>Không Hoạt Động</div>
                                        </div>
                                    } else
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Hoạt Động</div>
                                        </div>
                                    }
                                </a>
                            } else
                            {
                                if (item.IsLocked == true)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-danger badge-dot m-r-10"></div>
                                        <div>Không Hoạt Động</div>
                                    </div>
                                } else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-success badge-dot m-r-10"></div>
                                        <div>Hoạt Động</div>
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            }
        </table>
    </div>
</div>
