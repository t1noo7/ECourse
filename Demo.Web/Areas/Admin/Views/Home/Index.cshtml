@using Demo.Web.Areas.Admin.Models
@using Demo.Common.Extensions
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-3">
    <div class="col-lg-4">
        <form method="get" asp-action="Index">
            <label for="filterType" class="font-weight-bold">Lọc theo:</label>
            <select name="filterType" id="filterType" class="form-control">
                <option value="1">Tuần</option>
                <option value="2">Tháng</option>
            </select>
        </form>
    </div>
</div>
﻿
<div class="row">
    <div class="col-lg-5">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="m-b-0 text-muted">Doanh số</p>
                                <h2 class="m-b-0">@Model.Revenue.ToString("#,##0") VNĐ</h2>
                            </div>
                            <span class="badge badge-pill badge-cyan font-size-12">
                                <i class="anticon anticon-arrow-up"></i>
                                <span class="font-weight-semibold m-l-5">@Model.RevenueChange %</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="m-b-0 text-muted">Học viên</p>
                                <h2 class="m-b-0">@Model.TotalStudents</h2>
                            </div>
                            <span class="badge badge-pill badge-red font-size-12">
                                <i class="anticon anticon-arrow-down"></i>
                                <span class="font-weight-semibold m-l-5">3.26%</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="m-b-0 text-muted">Đơn hàng</p>
                                <h2 class="m-b-0">@Model.TotalOrders</h2>
                            </div>
                            <span class="badge badge-pill badge-cyan font-size-12">
                                <i class="anticon anticon-arrow-up"></i>
                                <span class="font-weight-semibold m-l-5">@Model.OrderChange %</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5>Đơn hàng gần đây</h5>
                    <a href="javascript:void(0);" class="btn btn-sm btn-default">Xem chi tiết</a>
                </div>
                <div class="m-t-30">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th>Khóa học đăng ký</th>
                                    <th>Ngày tạo</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>@order.OrderCode</td>
                                        <td>@order.Email</td>
                                        <td>@order.PhoneNumber</td>
                                        <td>@order.CourseName</td>
                                        <td>@order.OrderDate</td>
                                        <td>@order.Status.GetEnumDescription()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5>Doanh thu</h5>
                </div>
                <div class="m-t-30">
                    <div class="d-md-flex">
                        <div class="pr-4 m-v-10 border-right border-hide-md">
                            <p class="m-b-0">Doanh thu</p>
                            <h3 class="m-b-0">
                                <span>@Model.Revenue.ToString("#,##0") VNĐ</span>
                                <span class="text-success m-l-10 font-size-14">+6.71%</span>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="m-t-50" style="height: 240px">
                    <canvas class="chart" id="revenue-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5>Khóa học phổ biến</h5>
                <ul class="list-group list-group-flush">
                    @foreach(var course in Model.PopularCourses)
                    {
                        <li class="list-group-item p-h-0">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex">
                                    <div class="avatar avatar-image m-r-15">
                                        <img src="@course.Image" alt="@course.CourseName">
                                    </div>
                                    <div>
                                        <h6 class="m-b-0">@course.CourseName</h6>
                                        <p class="m-b-0 font-size-13">Số lượng học viên đã tham gia: <strong>@course.EnrolledStudents</strong> học viên</p>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById("revenue-chart").getContext("2d");

        var revenueChart = new Chart(ctx, {
            type: "line",
            data: {
                labels: ["16th", "17th", "18th", "19th", "20th", "21th", "22th", "23th", "24th", "25th", "26th"],
                datasets: [{
                    label: "Doanh thu",
                    data: [30, 60, 40, 50, 45, 70, 90, 75, 80, 55, 65],
                    borderColor: "#00c9a7",
                    backgroundColor: "rgba(0, 201, 167, 0.2)",
                    tension: 0.4,
                    pointRadius: 5,
                    pointBackgroundColor: "#00c9a7",
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return value + "M";
                            }
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    });

    document.getElementById("btnFilter").addEventListener("click", function () {
        this.closest("form").submit();
    });

    document.getElementById("filterType").addEventListener("change", function () {
        this.form.submit();
    });
</script>