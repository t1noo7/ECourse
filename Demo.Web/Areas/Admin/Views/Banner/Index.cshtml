@using Demo.Core.Models
@model List<Banner>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách banner";
}
@section Button {
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})"
       class="btn btn-primary btn-sm pull-right"><i class="anticon anticon-plus-circle m-r-5"></i>Thêm Mới</a>
}
<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tiêu Đề</th>
                    <th>Ảnh</th>
                    <th>Thứ tự</th>
                    <th>Ngày Tạo</th>
                    <th>Trạng Thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="sortable">
                @{
                    var stt = 1;
                    foreach (var item in Model.OrderBy(x => x.Order)) // Sắp xếp theo Order để hiển thị đúng thứ tự
                    {
                        <tr class="stat even" data-id="@item.Id">
                            <td class="ac">@(stt++)</td>
                            <td>@item.Title</td>
                            <td><img src="@item.Image" class="img64x64" /></td>
                            <td>@item.Order</td>
                            <td>@item.Created</td>
                            <td>
                                <a href="@Url.Action("ChangeStatus", new { id = item.Id, status = !item.Status })"
                                   onclick="return confirm('Bạn có chắc chắn muốn đổi trạng thái?')" class="text-info">
                                    @if (!item.Status)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-danger badge-dot m-r-10"></div>
                                            <div>Không Hoạt Động</div>
                                        </div>
                                    } else
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Hoạt Động</div>
                                        </div>
                                    }
                                </a>
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { item.Id })" class="btn btn-success m-r-5">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { item.Id })" class="btn btn-danger m-r-5"
                                   onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script>
        $(function () {
            $(".sortable").sortable({
                axis: "y", // Chỉ kéo thả theo chiều dọc
                update: function (event, ui) {
                    var sortedIds = $(".sortable tr").map(function () {
                        return $(this).attr("data-id");
                    }).get();

                    console.log("Dữ liệu gửi đi:", sortedIds); // Kiểm tra ID gửi đi

                    $.ajax({
                        url: '@Url.Action("UpdateOrder", "Banner")',
                        type: 'POST',
                        contentType: "application/json",
                        data: JSON.stringify({ ids: sortedIds }),
                        success: function (response) {
                            console.log("Response từ server:", response); // Kiểm tra phản hồi server
                            if (response.success) {
                                alert("Thứ tự đã được cập nhật!");
                            } else {
                                alert("Cập nhật thất bại!");
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Lỗi khi cập nhật:", xhr.responseText);
                            alert("Lỗi khi cập nhật!");
                        }
                    });
                }
            }).disableSelection();
        });
    </script>
}
