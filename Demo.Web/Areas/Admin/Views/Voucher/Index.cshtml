@using Demo.Core.Models
@model List<Voucher>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["Title"] = "Danh sách Voucher";
    var searchModel = ViewBag.SearchModel as Demo.Application.Models.OrderFilter;
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i>Home
            </a>
            <span class="breadcrumb-item active">Danh sách Voucher</span>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh sách Voucher</h4>
    <a href="@Url.Action("Edit", new { returnUrl = Context.Request.GetEncodedUrl()})" class="btn btn-primary">
        <i class="anticon anticon-plus-circle m-r-5"></i>Thêm Mới
    </a>
</div>

<div class="card mt-2 mb-2 shadow-base pd-b-10">
    <div class="card-body pb-0">
        <table class="table mg-b-0" cellspacing="0">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã Voucher</th>
                    <th>Số lượng ban đầu</th>
                    <th>Số lượng đã dùng</th>
                    <th>Giảm giá %</th>
                    <th>Giảm giá vnđ</th>
                    <th>Ngày tạo</th>
                    <th>Ngày hết hạn</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="sortable">
                @{
                    var stt = 1;
                    foreach (var item in Model.OrderByDescending(m => m.Created))
                    {
                        <tr class="stat even" data-id="@item.Id">
                            <td class="ac">@(stt++)</td>
                            <td>@item.Code</td>
                            <td>@item.Quantity</td>
                            <td>@item.UsedOrderIds.Count</td>
                            <td>@item.DiscountRate</td>
                            <td>@item.DiscountAmount.ToString("N0")</td>
                            <td>@item.Created.ToString("dd/MM/yyyy")</td>
                            <td>@item.Expired.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})"
                                    class="btn btn-success m-r-5 btn-sm"><i class="fas fa-pencil-alt"></i></a>
                                <a href="@Url.Action("Delete", new { item.Id, returnUrl = Context.Request.GetEncodedUrl()})"
                                    class="btn btn-danger m-r-5 btn-sm"
                                    onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>